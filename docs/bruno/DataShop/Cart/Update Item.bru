meta {
  name: Update Item
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/cart/items/{{cartItemId}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "quantity": 3
  }
}

tests {
  test("200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body.items.some((item) => item.quantity === 3)).to.equal(true);
  });
}
