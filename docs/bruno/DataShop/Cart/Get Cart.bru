meta {
  name: Get Cart
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/cart
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{customerToken}}
}

tests {
  test("200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("items");
    expect(res.body).to.have.property("total");
  });
}
