meta {
  name: Register Customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "{{customerEmail}}",
    "password": "{{customerPassword}}"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.accessToken) {
    bru.setVar("customerToken", res.body.accessToken);
  }
}

docs {
  Creates a customer once. A repeated run may return 409; in that case use "Login Customer".
}

tests {
  test("created or already exists", function() {
    expect([201, 409]).to.include(res.status);
  });
}
