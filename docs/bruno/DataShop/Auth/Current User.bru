meta {
  name: Current User
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{customerToken}}
}

tests {
  test("200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getEnvVar("customerEmail"));
  });
}
