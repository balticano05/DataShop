meta {
  name: Admin Check
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/auth/admin-check
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body.user.role).to.equal("admin");
  });
}
