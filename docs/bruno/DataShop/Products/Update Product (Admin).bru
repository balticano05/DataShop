meta {
  name: Update Product (Admin)
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/products/{{productId}}
  body: json
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "title": "Bruno Test Dataset (updated)",
    "price": 1399.00,
    "stockQuantity": 20
  }
}

tests {
  test("200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body.title).to.equal("Bruno Test Dataset (updated)");
  });
}
