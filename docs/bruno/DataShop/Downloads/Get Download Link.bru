meta {
  name: Get Download Link
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/downloads/{{productId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{customerToken}}
}

docs {
  Requires a paid order and a dataset attached to the product. Run Checkout first, then upload a dataset with "Upload Dataset" if the product has no filePublicId.
}

tests {
  test("download URL", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("url");
    expect(res.body).to.have.property("expiresIn");
  });
}
