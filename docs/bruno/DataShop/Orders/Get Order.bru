meta {
  name: Get Order
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/orders/{{orderId}}
  body: none
  auth: bearer
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{customerToken}}
}

tests {
  test("200 OK", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("orderId"));
  });
}
